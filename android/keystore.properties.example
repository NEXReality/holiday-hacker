# Copy to android/keystore.properties and fill in (do NOT commit keystore.properties).
# Point storeFile at your .jks / .keystore (path relative to android/ folder).
#
# Generate keystore once (from project root):
#   keytool -genkey -v -keystore holiday-hacker-release.jks -alias holidayhacker -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .jks file outside git (see root .gitignore).

storeFile=../holiday-hacker-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=holidayhacker
keyPassword=YOUR_KEY_PASSWORD
